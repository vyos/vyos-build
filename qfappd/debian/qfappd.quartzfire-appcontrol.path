[Unit]
Description=Watch QuartzFire Application Control desired state for changes
Documentation=file:/usr/share/doc/qfappd/design.md

[Path]
# The WebUI (unprivileged) writes desired state here; this triggers the root
# apply helper, which validates and publishes /run/qfappd/policy.json.
#
# PathChanged ONLY — never PathExists=: systemd re-evaluates path conditions
# whenever the triggered unit deactivates, and a PathExists= condition on a
# file that always exists is then satisfied again immediately, re-starting the
# oneshot in a tight loop until start-limit-hit kills BOTH units — after which
# WebUI saves are silently never applied. The boot-time initial apply comes
# from the apply service itself being WantedBy=multi-user.target instead.
PathChanged=/config/quartzfire/appcontrol.json
Unit=quartzfire-appcontrol-apply.service

[Install]
WantedBy=multi-user.target
