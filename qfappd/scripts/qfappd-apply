#!/usr/bin/env bash
#
# qfappd-apply — publish the WebUI's desired Application Control state to the
# running daemon. Triggered by quartzfire-appcontrol.path on changes to the
# persistent desired-state file. Runs as root (oneshot unit).
#
# Flow (mirrors the QuartzFire IPS apply pattern):
#   1. wait for the desired-state file (may lag /config mounting at boot),
#   2. validate it against the installed nDPI catalog with `qfappd check-policy`,
#   3. atomically publish it to /run/qfappd/policy.json (last-known-good: a bad
#      file is refused here and the previous runtime policy is left in place),
#   4. SIGHUP qfappd so it reloads immediately (inotify also catches it).
set -euo pipefail

DESIRED=/config/quartzfire/appcontrol.json
RUNTIME_DIR=/run/qfappd
RUNTIME=${RUNTIME_DIR}/policy.json
REPORT=${RUNTIME_DIR}/apply.json
QFAPPD=/usr/sbin/qfappd

log() { echo "qfappd-apply: $*" >&2; }

# Last-run report for the WebUI (world-readable): validation failures happen
# BEFORE the policy reaches qfappd, so without this file a refused desired
# state is invisible — qfappd keeps enforcing the previous policy and its own
# status shows no error. desired_mtime/size identify which revision of the
# desired file this run processed (the WebUI compares against the current one
# to detect a saved-but-never-applied state).
write_report() { # $1 = true|false, $2 = error text ("" on success)
    local ok=$1 err=$2 mtime=0 size=0
    if [ -f "$DESIRED" ]; then
        mtime=$(stat -c %Y "$DESIRED" 2>/dev/null || echo 0)
        size=$(stat -c %s "$DESIRED" 2>/dev/null || echo 0)
    fi
    err=$(printf '%s' "$err" | tr -d '\r' | tr '\n\t' '  ' | sed 's/\\/\\\\/g; s/"/\\"/g')
    local tmp="${REPORT}.tmp.$$"
    printf '{"ok":%s,"error":"%s","time":%s,"desired_mtime":%s,"desired_size":%s}\n' \
        "$ok" "$err" "$(date +%s)" "$mtime" "$size" > "$tmp"
    chmod 0644 "$tmp"
    mv -f "$tmp" "$REPORT"
}

# /config mounts late on VyOS; give it a bounded chance to appear.
for _ in $(seq 1 30); do
    [ -f "$DESIRED" ] && break
    sleep 1
done
if [ ! -f "$DESIRED" ]; then
    log "no desired-state file at $DESIRED; nothing to apply"
    exit 0
fi

mkdir -p "$RUNTIME_DIR"

# Validate before publishing. On failure we DO NOT touch the runtime policy —
# qfappd keeps enforcing the last-known-good one.
if ! check_out=$("$QFAPPD" check-policy "$DESIRED" 2>&1); then
    log "desired state failed validation; keeping current runtime policy"
    log "$check_out"
    write_report false "desired state failed validation: $check_out"
    exit 1
fi

# Publish atomically.
tmp="${RUNTIME}.tmp.$$"
cp "$DESIRED" "$tmp"
chmod 0640 "$tmp"
chgrp qfappd "$tmp" 2>/dev/null || true
mv -f "$tmp" "$RUNTIME"
log "published $RUNTIME"

# Nudge the daemon (inotify will also fire; SIGHUP makes it prompt).
if systemctl is-active --quiet qfappd.service; then
    systemctl kill -s HUP qfappd.service || true
fi

write_report true ""
