#!/usr/bin/python3
# Ensure the QuartzFire WebUI's VyOS API key exists and is present in the boot
# configuration, so the appliance works out of the box with no manual
# `set service https api keys ...` step. Idempotent and safe to run every boot.
#
# The key is generated per device on first boot (not baked into the image), so
# every QuartzFire install gets a unique key.
#
# This runs BEFORE vyos-router.service and edits /config/config.boot with
# vyos.configtree (a plain parse/edit/serialize, same mechanism the VyOS
# cloud-init module uses). The normal boot config load then applies the key as
# part of the regular boot commit. Deliberately NOT implemented with
# ConfigSession: a boot-time runtime commit races the config daemons, and a
# leaked session (e.g. teardown failing at interpreter shutdown) wedges every
# subsequent config session on the box ("can't initialize output").

import os
import re
import sys
import grp
import secrets

KEY_FILE = "/etc/quartzfire/vyos-api.key"
CONFIG_BOOT = "/config/config.boot"
KEY_ID = "quartzfire"
API_PATH = ["service", "https", "api"]


def ensure_key_file():
    """Return the API key, generating and persisting a fresh one if absent."""
    if os.path.exists(KEY_FILE) and os.path.getsize(KEY_FILE) > 0:
        with open(KEY_FILE) as f:
            return f.read().strip()

    key = secrets.token_hex(32)
    os.makedirs(os.path.dirname(KEY_FILE), exist_ok=True)
    with open(KEY_FILE, "w") as f:
        f.write(key + "\n")

    # root:quartzfire 0640 — readable by the DynamicUser backend via its group.
    try:
        gid = grp.getgrnam("quartzfire").gr_gid
    except KeyError:
        gid = 0
    os.chown(KEY_FILE, 0, gid)
    os.chmod(KEY_FILE, 0o640)
    return key


def split_version_footer(text):
    """Split config.boot into (body, footer).

    config.boot ends with component-version metadata comments that the config
    parser does not own; keep them byte-identical and re-append after editing.
    """
    m = re.search(r"^// (Warning:|vyos-config-version|Release version)",
                  text, re.MULTILINE)
    if m:
        return text[:m.start()], text[m.start():]
    return text, ""


def main():
    key = ensure_key_file()

    try:
        from vyos.configtree import ConfigTree
    except ImportError:
        # Not a VyOS system (e.g. a dev box) — the key file is enough.
        print("quartzfire: VyOS not detected, skipping API key registration",
              file=sys.stderr)
        return 0

    if not os.path.isfile(CONFIG_BOOT):
        # Nothing to edit (e.g. live boot before a config exists). The key
        # file is in place; the next boot with a config.boot will register it.
        print(f"quartzfire: {CONFIG_BOOT} not found, skipping registration",
              file=sys.stderr)
        return 0

    with open(CONFIG_BOOT) as f:
        body, footer = split_version_footer(f.read())

    config = ConfigTree(body)

    # `rest` is a separate container node — enabling it is what mounts the REST
    # endpoints (/retrieve, /configure, ...). Without it VyOS returns 404 there.
    rest_path = API_PATH + ["rest"]
    key_path = API_PATH + ["keys", "id", KEY_ID, "key"]

    changed = False
    if not config.exists(rest_path):
        config.set(rest_path)
        changed = True
    if not config.exists(key_path) or config.return_value(key_path) != key:
        config.set(key_path, value=key, replace=True)
        config.set_tag(API_PATH + ["keys", "id"])
        changed = True

    if not changed:
        return 0

    new_body = config.to_string()
    if not new_body.endswith("\n"):
        new_body += "\n"

    # Atomic replace, preserving ownership/mode (vyattacfg needs group rw).
    st = os.stat(CONFIG_BOOT)
    tmp = CONFIG_BOOT + ".quartzfire.tmp"
    with open(tmp, "w") as f:
        f.write(new_body + footer)
        f.flush()
        os.fsync(f.fileno())
    os.chown(tmp, st.st_uid, st.st_gid)
    os.chmod(tmp, st.st_mode & 0o7777)
    os.replace(tmp, CONFIG_BOOT)

    print("quartzfire: added VyOS REST API + WebUI key to config.boot")
    return 0


if __name__ == "__main__":
    sys.exit(main())
