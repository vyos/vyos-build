#!/usr/bin/python3
# Ensure the QuartzFire WebUI's VyOS API key exists and is present in the boot
# configuration, so the appliance works out of the box with no manual
# `set service https api keys ...` step. Idempotent and safe to run every boot.
#
# The key is generated per device on first boot (not baked into the image), so
# every QuartzFire install gets a unique key.
#
# Primary invocation: the QuartzFire default preconfig hook
# (/config/scripts/vyos-preconfig-bootup.script), which vyos-router runs after
# config.boot has been created and migrated but BEFORE it is loaded — the boot
# commit then applies the key. vyos-router exports BOOTFILE with the config
# path; /config is only bind-mounted at the END of vyos-router startup, so the
# file's canonical home is /opt/vyatta/etc/config/config.boot.
#
# Also run (belt and braces) by quartzfire-register-api-key.service before
# vyos-router: on anything but the very first boot the persisted config.boot
# already exists there, and on dev boxes it at least materialises the key file.
#
# Deliberately NOT implemented with ConfigSession: a boot-time runtime commit
# races the config daemons, and a leaked session (e.g. teardown failing at
# interpreter shutdown) wedges every subsequent config session on the box
# ("can't initialize output").

import os
import re
import sys
import grp
import shutil
import secrets

KEY_FILE = "/etc/quartzfire/vyos-api.key"
KEY_ID = "quartzfire"
API_PATH = ["service", "https", "api"]

# The VyOS API serves TLS itself and defaults to :443, which nginx owns for
# the WebUI. On fresh systems pin it to loopback on a dedicated port; the
# backend's vyos_api_url points here.
API_LISTEN = "127.0.0.1"
API_PORT = "4443"


def ensure_key_file():
    """Return the API key, generating and persisting a fresh one if absent."""
    if os.path.exists(KEY_FILE) and os.path.getsize(KEY_FILE) > 0:
        with open(KEY_FILE) as f:
            return f.read().strip()

    key = secrets.token_hex(32)
    os.makedirs(os.path.dirname(KEY_FILE), exist_ok=True)
    with open(KEY_FILE, "w") as f:
        f.write(key + "\n")

    # root:quartzfire 0640 — readable by the DynamicUser backend via its group.
    try:
        gid = grp.getgrnam("quartzfire").gr_gid
    except KeyError:
        gid = 0
    os.chown(KEY_FILE, 0, gid)
    os.chmod(KEY_FILE, 0o640)
    return key


def find_config_boot():
    """Locate the boot config, preferring vyos-router's exported BOOTFILE."""
    candidates = []
    if os.environ.get("BOOTFILE"):
        candidates.append(os.environ["BOOTFILE"])
    candidates += [
        "/opt/vyatta/etc/config/config.boot",  # canonical persisted location
        "/config/config.boot",                 # bind mount, post vyos-router
    ]
    for path in candidates:
        if os.path.isfile(path):
            return path
    return None


def split_version_footer(text):
    """Split config.boot into (body, footer).

    config.boot ends with component-version metadata comments that the config
    parser does not own; keep them byte-identical and re-append after editing.
    """
    m = re.search(r"^// (Warning:|vyos-config-version|Release version)",
                  text, re.MULTILINE)
    if m:
        return text[:m.start()], text[m.start():]
    return text, ""


def main():
    key = ensure_key_file()

    try:
        from vyos.configtree import ConfigTree
    except ImportError:
        # Not a VyOS system (e.g. a dev box) — the key file is enough.
        print("quartzfire: VyOS not detected, skipping API key registration",
              file=sys.stderr)
        return 0

    config_boot = find_config_boot()
    if config_boot is None:
        # First boot before vyos-router has created config.boot; the preconfig
        # hook invocation (which runs after that) will register the key.
        print("quartzfire: config.boot not found, skipping registration",
              file=sys.stderr)
        return 0

    with open(config_boot) as f:
        body, footer = split_version_footer(f.read())

    config = ConfigTree(body)

    changed = False

    # Only pin listen-address/port on a system where the operator has not
    # configured `service https` at all — never clobber an existing choice.
    if not config.exists(["service", "https"]):
        config.set(["service", "https", "listen-address"],
                   value=API_LISTEN, replace=True)
        config.set(["service", "https", "port"], value=API_PORT, replace=True)
        changed = True

    # `rest` is a separate container node — enabling it is what mounts the REST
    # endpoints (/retrieve, /configure, ...). Without it VyOS returns 404 there.
    rest_path = API_PATH + ["rest"]
    key_path = API_PATH + ["keys", "id", KEY_ID, "key"]

    if not config.exists(rest_path):
        config.set(rest_path)
        changed = True
    if not config.exists(key_path) or config.return_value(key_path) != key:
        config.set(key_path, value=key, replace=True)
        config.set_tag(API_PATH + ["keys", "id"])
        changed = True

    if not changed:
        return 0

    new_body = config.to_string()
    if not new_body.endswith("\n"):
        new_body += "\n"

    # Atomic replace, preserving ownership/mode (vyattacfg needs group rw).
    st = os.stat(config_boot)
    tmp = config_boot + ".quartzfire.tmp"
    with open(tmp, "w") as f:
        f.write(new_body + footer)
        f.flush()
        os.fsync(f.fileno())
    os.chown(tmp, st.st_uid, st.st_gid)
    os.chmod(tmp, st.st_mode & 0o7777)
    os.replace(tmp, config_boot)

    # vyos-router (init_bootfile) mirrors config.boot into the vyconf config
    # dir before we run; refresh the mirror so a vyconf-backed load sees our
    # edit. VYCONF_CONFIG_DIR is only present when exported by vyos-router.
    vyconf_dir = os.environ.get("VYCONF_CONFIG_DIR")
    if vyconf_dir and os.path.isdir(vyconf_dir):
        shutil.copy2(config_boot, os.path.join(vyconf_dir, "config.boot"))

    print(f"quartzfire: added VyOS REST API + WebUI key to {config_boot}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
