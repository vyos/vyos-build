[Unit]
Description=Register QuartzFire WebUI API key with VyOS
# Inject the key into /config/config.boot BEFORE vyos-router loads it, so the
# normal boot commit applies the key. No runtime ConfigSession/commit — a
# boot-time session that fails teardown wedges the config CLI system-wide.
Before=vyos-router.service
After=local-fs.target
ConditionPathExists=/usr/libexec/quartzfire/register-api-key

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/quartzfire/register-api-key

[Install]
WantedBy=multi-user.target
