[Unit]
Description=Register QuartzFire WebUI API key with VyOS
# Belt-and-braces invocation: the PRIMARY mechanism is the preconfig hook
# (/config/scripts/vyos-preconfig-bootup.script), which vyos-router runs after
# creating/migrating config.boot but before loading it. This unit additionally
# runs before vyos-router — on anything but the very first boot the persisted
# config.boot already exists at /opt/vyatta/etc/config, and on dev boxes it at
# least materialises the key file. The script is idempotent.
Before=vyos-router.service
After=local-fs.target
ConditionPathExists=/usr/libexec/quartzfire/register-api-key

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/quartzfire/register-api-key

[Install]
WantedBy=multi-user.target
