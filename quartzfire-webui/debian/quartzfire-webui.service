[Unit]
Description=QuartzFire WebUI backend
After=network-online.target quartzfire-register-api-key.service
Wants=network-online.target quartzfire-register-api-key.service

[Service]
Type=simple
ExecStart=/usr/bin/quartzfire-webui
Environment=QUARTZFIRE_WEBUI_CONFIG=/etc/quartzfire/webui.toml
Restart=on-failure
RestartSec=2
# Hardening — the backend only needs to read its config/key, talk localhost,
# and follow the kernel journal (systemd-journal) for the Traffic Monitor.
DynamicUser=yes
SupplementaryGroups=quartzfire systemd-journal
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/etc/quartzfire
# Writable persistent dir (/var/lib/quartzfire-webui) for the session-signing
# secret, generated on first start so logins survive restarts.
StateDirectory=quartzfire-webui
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
