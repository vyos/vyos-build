#!/bin/sh
set -e

case "$1" in
    configure)
        # Group used to hand the API key to the DynamicUser backend service.
        if ! getent group quartzfire >/dev/null; then
            addgroup --system quartzfire
        fi

        # The API key is generated per device on FIRST BOOT and registered with
        # VyOS by quartzfire-register-api-key.service — not here — so every
        # install gets a unique key and no manual step is required.

        # Enable the nginx site.
        if [ -d /etc/nginx/sites-enabled ] && \
           [ ! -e /etc/nginx/sites-enabled/quartzfire-webui ]; then
            ln -s ../sites-available/quartzfire-webui \
                /etc/nginx/sites-enabled/quartzfire-webui
            # Drop Debian's default site so ours can be default_server.
            rm -f /etc/nginx/sites-enabled/default
        fi
        # VyOS images ship daemons disabled (the config system starts what is
        # configured), and nothing in VyOS manages nginx — we own it, so we
        # must enable it ourselves. `enable` works in the image-build chroot;
        # `reload-or-restart` only matters on a live system and must not fail
        # the install inside the chroot.
        if command -v nginx >/dev/null 2>&1; then
            systemctl enable nginx >/dev/null 2>&1 || true
            if nginx -t >/dev/null 2>&1; then
                systemctl reload-or-restart nginx >/dev/null 2>&1 || true
            fi
        fi
        ;;
esac

#DEBHELPER#

exit 0
