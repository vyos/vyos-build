<?xml version="1.0"?>
<!--
QuartzFire geolocation: vyos-1x XML interface definition.

This does NOT generate the CLI grammar - the hand-written cstore templates
under vyos/templates/ do that, and this file must be kept in sync with them.
It exists because vyos-configd resolves every commit diff path through the
vyos.xml_ref reference cache: a path missing from the cache raises inside
get_commit_scripts(), configd dies, and the committing vyshim hangs forever
waiting for a reply. postinst feeds this file to vyos-1x's
xml_ref/generate_cache.py + update_cache.py so `service geolocation` is a
known path (only node_type/multi/valueless/owner/priority survive into the
cache - help texts are cosmetic here).

The owner must match the node.def `end:` script and MUST end in .py:
configd parses the script path with a regex hard-requiring the suffix
(process_node_data), and crashes on anything else.
-->
<interfaceDefinition>
  <node name="service">
    <children>
      <node name="geolocation" owner="${vyos_conf_scripts_dir}/service_geolocation.py">
        <properties>
          <help>Country-based traffic filtering (geolocation)</help>
          <priority>990</priority>
        </properties>
        <children>
          <tagNode name="action">
            <properties>
              <help>Named country policy (geolocation action)</help>
            </properties>
            <children>
              <leafNode name="description">
                <properties>
                  <help>Description</help>
                </properties>
              </leafNode>
              <leafNode name="mode">
                <properties>
                  <help>Filtering mode</help>
                </properties>
              </leafNode>
              <leafNode name="country">
                <properties>
                  <help>ISO 3166-1 alpha-2 country code</help>
                  <multi/>
                </properties>
              </leafNode>
              <leafNode name="unknown-ip">
                <properties>
                  <help>Handling of IPs not present in the location database</help>
                </properties>
              </leafNode>
              <leafNode name="log">
                <properties>
                  <help>Log packets blocked by this action</help>
                  <valueless/>
                </properties>
              </leafNode>
            </children>
          </tagNode>
          <tagNode name="policy">
            <properties>
              <help>Geolocation policy (binds an action to a firewall rule)</help>
            </properties>
            <children>
              <leafNode name="action">
                <properties>
                  <help>Geolocation action applied by this policy</help>
                </properties>
              </leafNode>
              <leafNode name="ruleset">
                <properties>
                  <help>Firewall ruleset (base chain) containing the target rule</help>
                </properties>
              </leafNode>
              <leafNode name="rule">
                <properties>
                  <help>Target rule number in firewall ipv4 ruleset filter</help>
                </properties>
              </leafNode>
              <leafNode name="direction">
                <properties>
                  <help>Which address the country match applies to</help>
                </properties>
              </leafNode>
              <leafNode name="disable">
                <properties>
                  <help>Disable this policy without removing it</help>
                  <valueless/>
                </properties>
              </leafNode>
            </children>
          </tagNode>
        </children>
      </node>
    </children>
  </node>
</interfaceDefinition>
