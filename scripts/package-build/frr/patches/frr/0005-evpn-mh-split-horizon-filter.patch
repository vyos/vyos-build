diff --git a/configure.ac b/configure.ac
index 8778c24f2d..643ad3ee38 100644
--- a/configure.ac
+++ b/configure.ac
@@ -975,6 +975,73 @@ fi
 AC_SUBST([DFLT_NAME])
 AC_DEFINE_UNQUOTED([DFLT_NAME], ["$DFLT_NAME"], [Name of the configuration default set])
 
+
+dnl ------------------------------------------------------------
+dnl Check clang, libbpf, bpftool, result variable: HAVE_EBPF_TCX
+dnl ------------------------------------------------------------
+
+HAVE_EBPF_TCX=no
+AC_CHECK_PROG([CLANG], [clang], [clang])
+AC_CHECK_PROG([BPFTOOL], [bpftool], [bpftool])
+# 1.3 is needed for bpf_program__attach_tcx
+PKG_CHECK_MODULES([LIBBPF], [libbpf >= 1.3], [have_libbpf=yes], [have_libbpf=no])
+
+AS_IF([test "x$CLANG" != "x" -a "x$BPFTOOL" != "x" -a "x$have_libbpf" = "xyes"], [
+  AC_MSG_CHECKING([whether $CLANG supports BPF target])
+  echo "int x;" > conftest.c
+  $CLANG -O2 -target bpf -c conftest.c -o conftest.o >/dev/null 2>&1
+  if test $? -eq 0; then
+    AC_MSG_RESULT([yes])
+
+    AC_MSG_CHECKING([whether required eBPF headers are available])
+
+    # Command taken from https://github.com/libbpf/libbpf-bootstrap/commit/2b2426e0cdc1a39e30ece3361519757cb76e294a
+    # This is needed to have asm/types.h etc
+    CLANG_BPF_SYS_INCLUDES="`$CLANG -v -E - </dev/null 2>&1 \
+        | sed -n '/<...> search starts here:/,/End of search list./s| \(/.*\)|-idirafter \1|p' | tr '\n' ' '`"
+
+    printf "#include <linux/bpf.h>\n#include <bpf/bpf_helpers.h>\nint x;" > conftest2.c
+    $CLANG -O2 -target bpf $CLANG_BPF_SYS_INCLUDES $LIBBPF_CFLAGS -c conftest2.c -o conftest2.o >/dev/null 2>&1
+    if test $? -eq 0; then
+      AC_MSG_RESULT([yes])
+      HAVE_EBPF_TCX=yes
+    else
+      AC_MSG_RESULT([no])
+    fi
+    rm -f conftest2.c conftest2.o
+  else
+    AC_MSG_RESULT([no])
+  fi
+  rm -f conftest.c conftest.o
+])
+AC_SUBST([CLANG])
+AC_SUBST([BPFTOOL])
+AC_SUBST([LIBBPF_CFLAGS])
+AC_SUBST([LIBBPF_LIBS])
+AC_SUBST([CLANG_BPF_SYS_INCLUDES])
+
+
+dnl ----------------------------------------------
+dnl Optional Split Horizon Filter using TCX + eBPF
+dnl ----------------------------------------------
+
+AC_ARG_ENABLE(splithorizon,
+	AS_HELP_STRING([--enable-splithorizon], [Enable eBPF-based split horizon filter]),
+[case "${enableval}" in
+  yes) enable_splithorizon=yes ;;
+  no) enable_splithorizon=no ;;
+  *) AC_MSG_ERROR([bad value ${enableval} for --enable-splithorizon]) ;;
+esac],[enable_splithorizon=no])
+
+AS_IF([test "x$enable_splithorizon" = "xyes"], [
+  AS_IF([test "x$HAVE_EBPF_TCX" != "xyes"], [
+    AC_MSG_ERROR([Failed to enable requested Split Horizon Filtering: missing eBPF TCX support ])
+  ])
+  AC_DEFINE([HAVE_SPLIT_HORIZON_FILTER], [1], [Build with eBPF-based split horizon filter support])
+])
+AM_CONDITIONAL([HAVE_SPLIT_HORIZON_FILTER], [test "x$enable_splithorizon" = "xyes"])
+
+
 #
 # Python for clippy
 #
@@ -2917,7 +2984,7 @@ EOF
 EOF
 fi
     ], [
-    FRR_ALL_CCLS_FLAGS="$(echo ${LIBYANG_CFLAGS} ${LUA_INCLUDE} ${SQLITE3_CFLAGS} | sed -e 's/  */ /g')"
+    FRR_ALL_CCLS_FLAGS="$(echo ${LIBYANG_CFLAGS} ${LUA_INCLUDE} ${SQLITE3_CFLAGS} ${LIBBPF_CFLAGS} | sed -e 's/  */ /g')"
     FRR_ALL_CCLS_CFLAGS="$(echo ${CFLAGS} ${WERROR} ${AC_CFLAGS} ${SAN_FLAGS} | sed -e 's/  */ /g')"
     ac_frr_confdate="${CONFDATE}"
     ac_frr_sysconfdir="${frr_sysconfdir}/"
@@ -2976,6 +3043,7 @@ config file mask        : ${enable_configfile_mask}
 log file mask           : ${enable_logfile_mask}
 zebra protobuf enabled  : ${enable_protobuf:-yes}
 vici socket path        : ${vici_socket}
+split horizon filter    : ${enable_splithorizon}
 
 The above user and group must have read/write access to the state file
 directory and to the config files in the config file directory."
diff --git a/tests/topotests/Dockerfile b/tests/topotests/Dockerfile
index 4f1bb32a1a..86d5b45d61 100644
--- a/tests/topotests/Dockerfile
+++ b/tests/topotests/Dockerfile
@@ -74,6 +74,11 @@ RUN apt update -y && apt upgrade -y && \
         strace \
         tcpdump \
       && \
+    # eBPF compilation requirements
+    apt-get install -y \
+        clang \
+        llvm \
+      && \
     download-mibs && \
     wget --tries=5 --waitretry=10 --retry-connrefused https://raw.githubusercontent.com/FRRouting/frr-mibs/main/iana/IANA-IPPM-METRICS-REGISTRY-MIB -O /usr/share/snmp/mibs/iana/IANA-IPPM-METRICS-REGISTRY-MIB && \
     wget --tries=5 --waitretry=10 --retry-connrefused https://raw.githubusercontent.com/FRRouting/frr-mibs/main/ietf/SNMPv2-PDU -O /usr/share/snmp/mibs/ietf/SNMPv2-PDU && \
@@ -117,6 +122,40 @@ RUN echo "" >> /etc/security/limits.conf; \
 # Copy run scripts to facilitate users wanting to run the tests
 COPY docker/inner /opt/topotests
 
+# libbpf: we need at least 1.3 for TCX in Split Horizon Filter
+ARG LIBBPF_VERSION=1.8.0
+ARG LIBBPF_CHECKSUM=b7a1e685f90f6a63ead0dd85d053694b222975da8d09c1a966041cff6f0055ff
+RUN mkdir /tmp/compile-libbpf \
+    && cd /tmp/compile-libbpf \
+    && wget --tries=5 --waitretry=10 --retry-connrefused https://github.com/libbpf/libbpf/archive/refs/tags/v$LIBBPF_VERSION.tar.gz \
+    && echo "$LIBBPF_CHECKSUM  v$LIBBPF_VERSION.tar.gz" | sha256sum -c - \
+    && tar -xvf v$LIBBPF_VERSION.tar.gz \
+    && cd libbpf-$LIBBPF_VERSION/src \
+    && PREFIX=/usr/local LIBDIR=/usr/local/lib make \
+    && PREFIX=/usr/local LIBDIR=/usr/local/lib make install \
+    # Required for runtime search of libs in /usr/local/lib
+    && ldconfig \
+    && cd / \
+    && rm -rf /tmp/compile-libbpf \
+    ;
+
+
+# bpftool: Ubuntu package is only wrapper that chooses path
+# based on kernel version, this doesn't work under docker
+ARG BPFTOOL_VERSION=7.8.1
+ARG BPFTOOL_CHECKSUM=fed76b7acb54d810cc3982eb6394726010114977542fd146695887a7d904b60c
+RUN mkdir /tmp/compile-bpftool \
+    && cd /tmp/compile-bpftool \
+    && wget --tries=5 --waitretry=10 --retry-connrefused https://github.com/libbpf/bpftool/releases/download/v$BPFTOOL_VERSION/bpftool-libbpf-v$BPFTOOL_VERSION-sources.tar.gz \
+    && echo "$BPFTOOL_CHECKSUM  bpftool-libbpf-v$BPFTOOL_VERSION-sources.tar.gz" | sha256sum -c - \
+    && tar -xvf bpftool-libbpf-v$BPFTOOL_VERSION-sources.tar.gz \
+    && cd bpftool-libbpf-v$BPFTOOL_VERSION-sources/src \
+    && make \
+    && prefix=/usr/local make install \
+    && rm -rf /tmp/compile-bpftool \
+    && cd / \
+    ;
+
 ENV PATH "$PATH:/opt/topotests"
 
 RUN echo "cat /opt/topotests/motd.txt" >> /root/.profile && \
