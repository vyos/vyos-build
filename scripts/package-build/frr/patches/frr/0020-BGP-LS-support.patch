+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * BGP Link-State Traffic Engineering Database (RFC 9552)
+ * Copyright (C) 2025 Carmine Scarpitta
+ */
+
+#include <zebra.h>
+
+#include "lib/memory.h"
+#include "lib/log.h"
