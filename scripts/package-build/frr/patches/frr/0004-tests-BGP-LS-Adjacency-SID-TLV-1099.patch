+	if (sid_len != length - 4) {
+		stream_forward_getp(s, length - 1);
+		if (sid_len == -1) {
+			flog_warn(EC_BGP_LS_PACKET,
+				  "BGP-LS: %s wrong combination of V-Flag and L-Flag for Adjacency SID, ignoring",
+				  __func__);
