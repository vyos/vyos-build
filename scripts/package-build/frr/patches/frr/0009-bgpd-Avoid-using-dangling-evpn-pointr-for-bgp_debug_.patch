---
 bgpd/bgp_route.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/bgpd/bgp_route.c b/bgpd/bgp_route.c
index 4059a67e57..25dce00323 100644
--- a/bgpd/bgp_route.c
+++ b/bgpd/bgp_route.c
@@ -6085,6 +6085,7 @@ void bgp_update(struct peer *peer, const struct prefix *p, uint32_t addpath_id,
 	if (evpn && afi == AFI_L2VPN &&
 	    (soft_reconfig || !CHECK_FLAG(peer->af_flags[afi][safi], PEER_FLAG_SOFT_RECONFIG))) {
 		bgp_attr_set_evpn_overlay(&new_attr, evpn);
+		evpn = NULL;
 		p_evpn = NULL;
 	}
 
