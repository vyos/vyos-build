    3 0x55b847635fcc in bgp_nlri_parse_evpn bgpd/bgp_evpn.c:6501
    4 0x55b8477c2ac8 in bgp_nlri_parse bgpd/bgp_packet.c:322
    5 0x55b8477c9a89 in bgp_update_receive bgpd/bgp_packet.c:2506
