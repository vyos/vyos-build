 bgpd/bgp_vty.c                                |  23 ++-
 .../bgp_clear_peer_group_family/r1/frr.conf   |  26 +++
 .../bgp_clear_peer_group_family/r2/frr.conf   |  21 +++
 .../bgp_clear_peer_group_family/r3/frr.conf   |  21 +++
 .../test_bgp_clear_peer_group_family.py       | 175 ++++++++++++++++++
 6 files changed, 264 insertions(+), 9 deletions(-)
 create mode 100644 tests/topotests/bgp_clear_peer_group_family/r1/frr.conf
 create mode 100644 tests/topotests/bgp_clear_peer_group_family/r2/frr.conf
 create mode 100644 tests/topotests/bgp_clear_peer_group_family/r3/frr.conf
 create mode 100644 tests/topotests/bgp_clear_peer_group_family/test_bgp_clear_peer_group_family.py

diff --git a/bgpd/bgp_route.c b/bgpd/bgp_route.c
index 4059a67e57..31969d056b 100644
--- a/bgpd/bgp_route.c
+++ b/bgpd/bgp_route.c
@@ -7950,8 +7950,13 @@ void bgp_clear_route_all(struct peer *peer)
 	/* We may be able to batch multiple peers' clearing work: check
 	 * and see.
 	 */
-	if (bgp_clearing_batch_add_peer(peer->bgp, peer))
+	if (bgp_clearing_batch_add_peer(peer->bgp, peer)) {
+#ifdef ENABLE_BGP_VNC
+		/* Does not depend on the table walk, VNC still has to know */
+		rfapiProcessPeerDown(peer);
+#endif
 		return;
+	}
 
 	FOREACH_AFI_SAFI (afi, safi)
 		bgp_clear_route(peer, afi, safi);
diff --git a/bgpd/bgp_vty.c b/bgpd/bgp_vty.c
index 3a446ac9cd..adbea621fc 100644
