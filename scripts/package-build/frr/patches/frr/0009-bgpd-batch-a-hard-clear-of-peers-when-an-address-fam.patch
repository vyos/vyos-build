+++ b/bgpd/bgp_vty.c
@@ -1255,11 +1255,18 @@ static int bgp_clear(struct vty *vty, struct bgp *bgp, afi_t afi, safi_t safi,
 	bool found = false;
 	struct peer *peer;
 	bool afi_safi_unspec = false;
+	bool use_batch = false;
 
 	VTY_BGP_GR_DEFINE_LOOP_VARIABLE;
 
 	afi_safi_unspec = ((afi == AFI_UNSPEC) && (safi == SAFI_UNSPEC));
 
+	/*
+	 * A hard clear resets the whole session whatever address family is
+	 * given, the family only selects the peers, so it can be batched too.
+	 */
+	use_batch = afi_safi_unspec || (stype == BGP_CLEAR_SOFT_NONE);
+
 	/* Clear all neighbors. */
 	/*
 	 * Pass along pointer to next node to peer_clear() when walking all
@@ -1267,7 +1274,7 @@ static int bgp_clear(struct vty *vty, struct bgp *bgp, afi_t afi, safi_t safi,
 	 * doppelganger
 	 */
 	if (sort == clear_all) {
-		if (afi_safi_unspec)
+		if (use_batch)
 			bgp_clearing_batch_begin(bgp);
 		for (ALL_LIST_ELEMENTS(bgp->peer, node, nnode, peer)) {
 
@@ -1299,7 +1306,7 @@ static int bgp_clear(struct vty *vty, struct bgp *bgp, afi_t afi, safi_t safi,
 			bgp->advertisement_delay_over = 0;
 		}
 
-		if (afi_safi_unspec)
+		if (use_batch)
 			bgp_clearing_batch_end_event_start(bgp);
 		return CMD_SUCCESS;
 	}
@@ -1357,7 +1364,7 @@ static int bgp_clear(struct vty *vty, struct bgp *bgp, afi_t afi, safi_t safi,
 			return CMD_WARNING;
 		}
 
-		if (afi_safi_unspec)
+		if (use_batch)
 			bgp_clearing_batch_begin(bgp);
 		for (ALL_LIST_ELEMENTS(group->peer, node, nnode, peer)) {
 			ret = bgp_peer_clear(peer, afi, safi, &nnode, stype);
@@ -1367,7 +1374,7 @@ static int bgp_clear(struct vty *vty, struct bgp *bgp, afi_t afi, safi_t safi,
 			else
 				found = true;
 		}
-		if (afi_safi_unspec)
+		if (use_batch)
 			bgp_clearing_batch_end_event_start(bgp);
 
 		if (!found)
@@ -1380,7 +1387,7 @@ static int bgp_clear(struct vty *vty, struct bgp *bgp, afi_t afi, safi_t safi,
 
 	/* Clear all external (eBGP) neighbors. */
 	if (sort == clear_external) {
-		if (afi_safi_unspec)
+		if (use_batch)
 			bgp_clearing_batch_begin(bgp);
 		for (ALL_LIST_ELEMENTS(bgp->peer, node, nnode, peer)) {
 			if (peer->sort == BGP_PEER_IBGP)
@@ -1406,7 +1413,7 @@ static int bgp_clear(struct vty *vty, struct bgp *bgp, afi_t afi, safi_t safi,
 			   && bgp->present_zebra_gr_state == ZEBRA_GR_ENABLE) {
 			bgp_zebra_send_capabilities(bgp, true);
 		}
-		if (afi_safi_unspec)
+		if (use_batch)
 			bgp_clearing_batch_end_event_start(bgp);
 		if (!found)
 			vty_out(vty,
@@ -1425,7 +1432,7 @@ static int bgp_clear(struct vty *vty, struct bgp *bgp, afi_t afi, safi_t safi,
 			return CMD_WARNING;
 		}
 
-		if (afi_safi_unspec)
+		if (use_batch)
 			bgp_clearing_batch_begin(bgp);
 		for (ALL_LIST_ELEMENTS(bgp->peer, node, nnode, peer)) {
 			if (peer->as != as)
@@ -1452,7 +1459,7 @@ static int bgp_clear(struct vty *vty, struct bgp *bgp, afi_t afi, safi_t safi,
 			bgp_zebra_send_capabilities(bgp, true);
 		}
 
-		if (afi_safi_unspec)
+		if (use_batch)
 			bgp_clearing_batch_end_event_start(bgp);
 		if (!found)
 			vty_out(vty,
