#
# Wireless WAN
#
CONFIG_WWAN=y
CONFIG_WWAN_DEBUGFS=y
CONFIG_WWAN_HWSIM=m
CONFIG_IOSM=m
CONFIG_MTK_T7XX=m
# end of Wireless WAN

# The USB WWAN drivers below are requested as built-in, so their parent
# symbols must be built-in too - a tristate can never exceed the value of
# what it depends on. amd64 already had both =y, arm64 only had =m which
# silently demoted every driver in this snippet to a module.
CONFIG_USB_USBNET=y
CONFIG_USB_SERIAL=y

# USB_SERIAL_WWAN has no prompt - it is only ever reached via select,
# so it has to be pulled in by building its users in. amd64 already did this,
# arm64 had them as modules and therefore got USB_SERIAL_WWAN=m.
CONFIG_USB_SERIAL_QUALCOMM=y
CONFIG_USB_SERIAL_SIERRAWIRELESS=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_EEM=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_HUAWEI_CDC_NCM=y
CONFIG_USB_NET_CDC_MBIM=y
CONFIG_USB_NET_QMI_WWAN=y
CONFIG_USB_SIERRA_NET=y
