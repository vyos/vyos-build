+	 * happens after the call to load_config() from l2tp_init(), so this
+	 * only ever triggers on a reload.
+	 */
+	l2tp_parse_bind(&udp_serv.new_addr);
+	if (udp_serv.addr.sin_family == AF_INET &&
+	    memcmp(&udp_serv.new_addr, &udp_serv.addr, sizeof(udp_serv.addr)))
+		triton_context_call(&udp_serv.ctx,
+				    (triton_event_func)l2tp_udp_rebind,
+				    &udp_serv);
 }
 
