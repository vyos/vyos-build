+static int pptp_parse_bind(struct sockaddr_in *addr)
+{
+	char *opt;
+
+	memset(addr, 0, sizeof(*addr));
+	addr->sin_family = AF_INET;
+
+	opt = conf_get_opt("pptp", "bind");
+	if (opt) {
+		if (!inet_aton(opt, &addr->sin_addr)) {
+			log_error("pptp: failed to parse bind address '%s'\n", opt);
+			return -1;
+		}
+	} else
+		addr->sin_addr.s_addr = htonl(INADDR_ANY);
+
+	opt = conf_get_opt("pptp", "port");
+	if (opt && atoi(opt) > 0)
+		addr->sin_port = htons(atoi(opt));
+	else
+		addr->sin_port = htons(PPTP_PORT);
+
+	return 0;
+}
+
+/* Returns the listening socket, or -errno of the step that failed */
+static int pptp_serv_open(const struct sockaddr_in *addr)
+{
+	int fd, err, f = 1;
+
+	fd = socket(PF_INET, SOCK_STREAM, 0);
+	if (fd < 0) {
+		err = errno;
+		log_error("pptp: failed to create server socket: %s\n", strerror(err));
+		return -err;
+	}
+
+	fcntl(fd, F_SETFD, fcntl(fd, F_GETFD) | FD_CLOEXEC);
+	setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &f, sizeof(f));
+
+	if (bind(fd, (struct sockaddr *)addr, sizeof(*addr)) < 0) {
+		err = errno;
+		/* EADDRINUSE is expected while the old listener still overlaps */
+		if (err != EADDRINUSE)
+			log_error("pptp: failed to bind socket: %s\n", strerror(err));
+		goto out_err;
+	}
+
+	if (listen(fd, 100) < 0) {
+		err = errno;
+		log_error("pptp: failed to listen socket: %s\n", strerror(err));
+		goto out_err;
+	}
+
+	if (fcntl(fd, F_SETFL, O_NONBLOCK)) {
+		err = errno;
+		log_error("pptp: failed to set nonblocking mode: %s\n", strerror(err));
+		goto out_err;
+	}
+
+	return fd;
+
+out_err:
+	close(fd);
+	return -err;
+}
+
+static void pptp_serv_attach(struct pptp_serv_t *s, int fd)
+{
+	s->hnd.fd = fd;
+	triton_md_register_handler(&s->ctx, &s->hnd);
+	triton_md_enable_handler(&s->hnd, MD_MODE_READ);
+}
+
+static void pptp_serv_detach(struct pptp_serv_t *s)
+{
+	if (s->hnd.tpd)
+		triton_md_unregister_handler(&s->hnd, 1);
+}
+
+/*
+ * Runs in serv.ctx, so it is serialised against pptp_connect() on the
+ * listening socket. Established sessions have their own accepted sockets
+ * and are not affected by replacing the listener.
+ */
+static void pptp_serv_rebind(struct pptp_serv_t *s)
+{
+	char cur[INET_ADDRSTRLEN], new[INET_ADDRSTRLEN];
+	int fd, err;
+
+	inet_ntop(AF_INET, &s->addr.sin_addr, cur, sizeof(cur));
+	inet_ntop(AF_INET, &s->new_addr.sin_addr, new, sizeof(new));
+
+	/* open the replacement first, so a failure keeps the old listener */
+	fd = pptp_serv_open(&s->new_addr);
+	if (fd == -EADDRINUSE && s->hnd.tpd) {
+		/*
+		 * Linux refuses a bind() that overlaps a socket in LISTEN state
+		 * on the same port, SO_REUSEADDR notwithstanding - e.g. moving
+		 * from 0.0.0.0 to a specific address. Release the old listener
+		 * and fall back to it if the new address still fails.
+		 */
+		pptp_serv_detach(s);
+		fd = pptp_serv_open(&s->new_addr);
+		if (fd < 0) {
+			err = -fd;
+			fd = pptp_serv_open(&s->addr);
+			if (fd < 0) {
+				log_error("pptp: cannot bind %s:%i (%s), nor restore %s:%i,"
+					  " not listening\n",
+					  new, ntohs(s->new_addr.sin_port), strerror(err),
+					  cur, ntohs(s->addr.sin_port));
+				return;
+			}
+			pptp_serv_attach(s, fd);
+			log_error("pptp: cannot bind %s:%i (%s), still listening on %s:%i\n",
+				  new, ntohs(s->new_addr.sin_port), strerror(err),
+				  cur, ntohs(s->addr.sin_port));
+			return;
+		}
+	} else if (fd < 0) {
+		log_error("pptp: cannot bind %s:%i (%s), %s\n",
+			  new, ntohs(s->new_addr.sin_port), strerror(-fd),
+			  s->hnd.tpd ? "still listening on the old address" : "not listening");
+		return;
+	} else
+		pptp_serv_detach(s);
+
+	pptp_serv_attach(s, fd);
+	memcpy(&s->addr, &s->new_addr, sizeof(s->addr));
+
+	log_info1("pptp: now listening on %s:%i\n", new, ntohs(s->addr.sin_port));
+}
+
