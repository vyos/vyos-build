+static int start_udp_server(void)
+{
+	struct sockaddr_in addr;
+
+	l2tp_parse_bind(&addr);
+
+	udp_serv.hnd.fd = l2tp_udp_open(&addr);
+	if (udp_serv.hnd.fd < 0)
+		return -1;
+
 	memcpy(&udp_serv.addr, &addr, sizeof(addr));
 
 	if (triton_context_register(&udp_serv.ctx, NULL) < 0) {
@@ -4716,6 +4734,37 @@ err_fd:
 	return -1;
 }
 
+/*
+ * Runs in udp_serv.ctx, so it is serialised against l2tp_udp_read() on the
+ * server socket. Established tunnels have their own sockets and contexts and
+ * are not affected. The replacement socket is bound before the old one is
+ * dropped, so a bind failure leaves the running listener in place.
+ */
+static void l2tp_udp_rebind(struct l2tp_serv_t *serv)
+{
+	int fd;
+
+	fd = l2tp_udp_open(&serv->new_addr);
+	if (fd < 0) {
+		log_error("l2tp: cannot bind %s:%i, still listening on %s:%i\n",
+			  inet_ntoa(serv->new_addr.sin_addr),
+			  ntohs(serv->new_addr.sin_port),
+			  inet_ntoa(serv->addr.sin_addr),
+			  ntohs(serv->addr.sin_port));
+		return;
+	}
+
+	triton_md_unregister_handler(&serv->hnd, 1);
+	serv->hnd.fd = fd;
+	triton_md_register_handler(&serv->ctx, &serv->hnd);
+	triton_md_enable_handler(&serv->hnd, MD_MODE_READ);
+
+	memcpy(&serv->addr, &serv->new_addr, sizeof(serv->addr));
+
+	log_info1("l2tp: now listening on %s:%i\n",
+		  inet_ntoa(serv->addr.sin_addr), ntohs(serv->addr.sin_port));
+}
