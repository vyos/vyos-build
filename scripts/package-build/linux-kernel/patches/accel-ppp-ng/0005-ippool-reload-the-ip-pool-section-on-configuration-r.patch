 	struct ippool_t *next;
 	generate_func generate;
 	spinlock_t lock;
+	/* dropped from the configuration; drains as its leases are returned */
+	int dead;
+	/* only used while ippool_reload() is reconciling */
+	struct ippool_t *final;
 };
 
 struct ippool_item_t
 {
 	struct list_head entry;
 	struct ippool_t *pool;
+	/* address is no longer configured: free on release instead of reusing */
+	int stale;
 	struct ipv4db_item_t it;
 };
 
