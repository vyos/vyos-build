 	if (create)
@@ -363,6 +391,7 @@ static struct ipv4db_item_t *get_ip(struct ap_session *ses)
 		if (!list_empty(&pool->items)) {
 			it = list_entry(pool->items.next, typeof(*it), entry);
 			list_del(&it->entry);
+			list_add_tail(&it->entry, &pool->used);
 		} else
 			it = NULL;
 		spin_unlock(&pool->lock);
@@ -387,10 +416,24 @@ static struct ipv4db_item_t *get_ip(struct ap_session *ses)
 static void put_ip(struct ap_session *ses, struct ipv4db_item_t *it)
 {
 	struct ippool_item_t *pit = container_of(it, typeof(*pit), it);
+	struct ippool_t *p = pit->pool;
+
+	spin_lock(&p->lock);
+	list_del(&pit->entry);
+
+	/*
+	 * A reload may have taken this address out of the pool while the
