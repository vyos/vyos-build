 }
 
 static struct ipdb_t ipdb = {
@@ -440,6 +483,7 @@ static int session_restore(struct ap_session *ses, struct backup_mod *m)
 	list_for_each_entry(it, &def_pool->items, entry) {
 		if (peer_addr == it->it.peer_addr && addr == it->it.addr) {
 			list_del(&it->entry);
+			list_add_tail(&it->entry, &def_pool->used);
 			it0 = it;
 			break;
 		}
@@ -452,6 +496,7 @@ static int session_restore(struct ap_session *ses, struct backup_mod *m)
 			list_for_each_entry(it, &p->items, entry) {
 				if (peer_addr == it->it.peer_addr && addr == it->it.addr) {
 					list_del(&it->entry);
+					list_add_tail(&it->entry, &p->used);
